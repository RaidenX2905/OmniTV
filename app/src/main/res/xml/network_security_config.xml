<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config permits cleartext traffic for legacy IPTV HTTP stream URLs, while enforcing system CA TLS verification for HTTPS -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

